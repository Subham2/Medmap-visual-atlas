# ---- Server ----
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.example
# Set when running behind Nginx / a load balancer so rate limits apply per client IP.
TRUST_PROXY=1

# ---- AI provider ----
# Leave GEMINI_API_KEY empty to run fully offline on the curated dataset.
# A Google key (AIza...) talks to Gemini directly and ignores GEMINI_BASE_URL.
GEMINI_API_KEY=
# Optional OpenAI-compatible gateway (chat/completions); must be https://
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-2.5-flash
# For aicredits.in (≈30 s gateway cap, 5 concurrent requests per key) the measured best choice is:
#   GEMINI_BASE_URL=https://aicredits.in/v1
#   GEMINI_MODEL=google/gemini-3.5-flash-lite
#   AI_FALLBACK_MODELS=openai/gpt-4.1-mini,gpt-4o-mini
# Comma-separated models tried in order after GEMINI_MODEL fails (same endpoint).
AI_FALLBACK_MODELS=gpt-4o-mini

# Optional failover provider, used only if the primary Gemini route fails.
AI_BACKUP_BASE_URL=
AI_BACKUP_API_KEY=

# ---- Tuning (defaults shown) ----
AI_TIMEOUT_MS=45000
AI_ATTEMPT_TIMEOUT_MS=28000
# Max simultaneous upstream AI calls; keep below the provider's per-key concurrency limit.
AI_MAX_CONCURRENCY=4
AI_CACHE_TTL_MS=1800000
AI_CACHE_MAX_ENTRIES=200
RATE_LIMIT_PER_MIN=30

# ---- Frontend (build-time, optional) ----
# Override firebase-applet-config.json per deployment.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_DATABASE_ID=
